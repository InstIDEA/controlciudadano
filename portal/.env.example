# Copiar a .env (o .env.production.local) y ajustar. Si no se definen, se usan
# los valores de controlcivico.org (ver src/Config.ts).
# OJO: se inyectan en tiempo de BUILD; si se cambian hay que volver a correr `yarn build`.
REACT_APP_API_URL=https://api.controlcivico.org/api
REACT_APP_CDN_URL=https://data.controlcivico.org/cdn/
REACT_APP_REDASH_API_URL=https://redash.controlcivico.org/api
REACT_APP_ELASTIC_URL=https://data.controlcivico.org/
REACT_APP_SITE_NAME=controlcivico.org
